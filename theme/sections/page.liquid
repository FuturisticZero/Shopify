{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="page-rich-text">
  <h1 class="page-title font-headline-lg uppercase text-surface-container-lowest mb-8">{{ page.title }}</h1>
  <div class="page-content font-body-md text-surface-container-lowest">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
