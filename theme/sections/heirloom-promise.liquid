<div class="promise-section">
  <div class="promise-card paper-texture shadow-inner">
    <div class="promise-grid">
      <!-- Left side: Heritage Stamp -->
      <div class="promise-stamp-panel">
        <div class="promise-stamp">
          <div class="promise-stamp-inner">
            <span class="promise-stamp-top">{{ section.settings.stamp_top }}</span>
            <span class="promise-stamp-mid">{{ section.settings.stamp_mid }}</span>
            <span class="promise-stamp-bottom">{{ section.settings.stamp_bottom }}</span>
          </div>
        </div>
      </div>

      <!-- Right side: Content -->
      <div class="promise-content-panel">
        <h2 class="promise-title">{{ section.settings.heading }}</h2>
        <div class="promise-description">
          {{ section.settings.description }}
        </div>
        <div class="promise-stats">
          <div class="promise-stat-item">
            <span class="promise-stat-val">{{ section.settings.stat_1_val }}</span>
            <span class="promise-stat-lbl">{{ section.settings.stat_1_lbl }}</span>
          </div>
          <div class="promise-stat-item">
            <span class="promise-stat-val">{{ section.settings.stat_2_val }}</span>
            <span class="promise-stat-lbl">{{ section.settings.stat_2_lbl }}</span>
          </div>
          <div class="promise-stat-item">
            <span class="promise-stat-val">{{ section.settings.stat_3_val }}</span>
            <span class="promise-stat-lbl">{{ section.settings.stat_3_lbl }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .promise-section {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .promise-card {
    position: relative;
    padding: 3rem 1.5rem;
    border-radius: var(--style-border-radius);
    overflow: hidden;
    background-color: #f5f5dc; /* Cream fallback */
    background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLsFkTdzROoOz7jUpqEn2a0w899NJIPEpPlNYFXAgS3TLRtOgOZozIbJQnq7GLCJvfw-W4Bj4B7ATLa8Pn1lPNvRBzrXL_LHfYdmRUSLVrfY0gLuIu-S5_lSVy32bnRVjFQN4-wsfx37k9iLOw2Lp-i80CNC9-Y22lTZKTXUz3c2oP7eiZVIt-zAjcEWZ4qsLqh5sj2OaWMBREjjBY0xUidPJEGH0o1-3G4HAg_2PSr5_xZ2puFq7JJyphxm');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }

  @media (min-width: 768px) {
    .promise-card {
      padding: 5rem;
    }
  }

  .promise-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .promise-grid {
      grid-template-columns: repeat(12, 1fr);
      gap: 2.5rem;
    }
  }

  .promise-stamp-panel {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .promise-stamp-panel {
      grid-column: span 4;
    }
  }

  .promise-stamp {
    width: 12rem;
    height: 12rem;
    border: 2px dashed rgba(128, 0, 32, 0.4); /* primary container color with opacity */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }

  .promise-stamp-inner {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(128, 0, 32, 0.2);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #800020; /* Burgundy text color */
  }

  .promise-stamp-top {
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .promise-stamp-mid {
    font-family: var(--font-headline-family);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    margin: 0.25rem 0;
    text-transform: uppercase;
  }

  .promise-stamp-bottom {
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .promise-content-panel {
    color: #1a1a1a; /* Dark charcoal text for high contrast on light paper */
  }

  @media (min-width: 768px) {
    .promise-content-panel {
      grid-column: span 8;
    }
  }

  .promise-title {
    color: #800020; /* Burgundy title */
    margin-bottom: 1.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .promise-title {
      text-align: left;
    }
  }

  .promise-description {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .promise-description p {
    margin-bottom: 1rem;
  }

  .promise-description p:last-child {
    margin-bottom: 0;
  }

  .promise-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-around;
  }

  @media (min-width: 768px) {
    .promise-stats {
      justify-content: flex-start;
      gap: 3rem;
    }
  }

  .promise-stat-item {
    display: flex;
    flex-direction: column;
  }

  .promise-stat-val {
    font-family: var(--font-headline-family);
    font-size: 1.75rem;
    font-weight: 800;
    color: #800020;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .promise-stat-lbl {
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #444444;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Heirloom Promise",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Heirloom Promise"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>At Heritage Butcher, we believe that exceptional flavor begins in the pasture. Our heirloom promise is a commitment to transparency, ethical husbandry, and the preservation of rare heritage breeds.</p><p>Every cut we sell is traceable to a single farm where animals are raised with respect, roaming freely on natural grass. We do not use growth hormones or unnecessary antibiotics.</p>"
    },
    {
      "type": "text",
      "id": "stamp_top",
      "label": "Stamp Top Text",
      "default": "GUARANTEED"
    },
    {
      "type": "text",
      "id": "stamp_mid",
      "label": "Stamp Middle Text",
      "default": "HERITAGE"
    },
    {
      "type": "text",
      "id": "stamp_bottom",
      "label": "Stamp Bottom Text",
      "default": "QUALITY"
    },
    {
      "type": "text",
      "id": "stat_1_val",
      "label": "Stat 1 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_1_lbl",
      "label": "Stat 1 Label",
      "default": "GRASS FED"
    },
    {
      "type": "text",
      "id": "stat_2_val",
      "label": "Stat 2 Value",
      "default": "28 DAY"
    },
    {
      "type": "text",
      "id": "stat_2_lbl",
      "label": "Stat 2 Label",
      "default": "MINIMUM AGING"
    },
    {
      "type": "text",
      "id": "stat_3_val",
      "label": "Stat 3 Value",
      "default": "SMALL"
    },
    {
      "type": "text",
      "id": "stat_3_lbl",
      "label": "Stat 3 Label",
      "default": "BATCH FARMS"
    }
  ],
  "presets": [
    {
      "name": "Heirloom Promise"
    }
  ]
}
{% endschema %}
