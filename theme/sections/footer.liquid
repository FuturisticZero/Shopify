<footer class="footer-section">
  <div class="footer-grid">
    <!-- Brand Info -->
    <div class="footer-brand-column">
      <h2 class="footer-brand-title">{{ shop.name }}</h2>
      <p class="footer-brand-desc">
        {{ section.settings.brand_description }}
      </p>
      <div class="footer-social-icons">
        <a href="#" class="social-icon-btn" aria-label="Instagram">
          <span class="material-symbols-outlined">photo_camera</span>
        </a>
        <a href="#" class="social-icon-btn" aria-label="Facebook">
          <span class="material-symbols-outlined">qr_code_2</span>
        </a>
      </div>
    </div>

    <!-- Navigation Menu -->
    <div class="footer-links-column">
      <h4 class="footer-column-heading">The Butcher Shop</h4>
      <nav class="footer-nav-list">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="footer-nav-link">{{ link.title }}</a>
        {% endfor %}
      </nav>
    </div>

    <!-- Newsletter Registry -->
    <div class="footer-newsletter-column">
      <h4 class="footer-column-heading">{{ section.settings.newsletter_heading }}</h4>
      <p class="footer-newsletter-desc">{{ section.settings.newsletter_text }}</p>
      
      {% form 'customer', class: 'footer-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="footer-newsletter-input-wrapper">
          <input
            type="email"
            name="contact[email]"
            class="footer-newsletter-input"
            value="{{ form.email }}"
            placeholder="Your Email Address"
            required
            aria-label="Email Address"
          >
          <button type="submit" class="btn footer-newsletter-submit">Join</button>
        </div>
      {% endform %}
    </div>
  </div>

  <!-- Bottom Copyright & Payments -->
  <div class="footer-bottom-panel">
    <div class="footer-bottom-container">
      <div class="footer-copyright-text">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Artisanal Excellence in Every Cut.
      </div>
      
      {% if section.settings.show_payment_icons %}
        <div class="footer-payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon-svg' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer-section {
    background-color: var(--color-surface-container-highest) !important;
    border-top: 1px solid rgba(228, 228, 204, 0.1);
    margin-top: var(--spacing-section-gap);
    padding-top: var(--spacing-section-gap-mobile);
    width: 100%;
  }

  @media (min-width: 768px) {
    .footer-section {
      padding-top: var(--spacing-section-gap);
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin) var(--spacing-section-gap-mobile);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      padding-bottom: var(--spacing-section-gap);
    }
  }

  .footer-brand-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-brand-title {
    font-family: var(--font-headline-family);
    font-size: 1.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: var(--color-primary) !important;
    margin: 0;
  }

  .footer-brand-desc {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    max-width: 20rem;
    margin: 0;
  }

  .footer-social-icons {
    display: flex;
    gap: 1rem;
  }

  .social-icon-btn {
    color: var(--color-secondary) !important;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .social-icon-btn:hover {
    color: var(--color-primary) !important;
  }

  .social-icon-btn .material-symbols-outlined {
    font-size: 1.5rem;
  }

  .footer-links-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-column-heading {
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0;
  }

  .footer-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-nav-link {
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant) !important;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-nav-link:hover {
    color: var(--color-primary) !important;
  }

  .footer-newsletter-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-newsletter-desc {
    font-family: var(--font-body-family);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    margin: 0;
  }

  .footer-newsletter-form {
    width: 100%;
    margin: 0;
  }

  .footer-newsletter-input-wrapper {
    display: flex;
    background-color: var(--color-surface-container-low);
    border: 1px solid rgba(228, 228, 204, 0.15);
    border-radius: var(--style-border-radius);
    padding: 0.25rem;
  }

  .footer-newsletter-input {
    flex-grow: 1;
    background-color: transparent !important;
    border: none !important;
    padding: 0.75rem 1rem !important;
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    color: var(--color-foreground);
    outline: none !important;
    box-shadow: none !important;
  }

  .footer-newsletter-input::placeholder {
    color: var(--color-outline);
    opacity: 0.5;
  }

  .footer-newsletter-submit {
    background-color: #800020 !important; /* Burgundy */
    color: #f5f5dc !important; /* cream */
    padding: 0.75rem 1.5rem !important;
    font-family: var(--font-label-family) !important;
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    transition: background-color 0.3s ease !important;
  }

  .footer-newsletter-submit:hover {
    background-color: #5d0016 !important;
  }

  .footer-bottom-panel {
    border-top: 1px solid rgba(228, 228, 204, 0.05);
    padding: 2rem 0;
  }

  .footer-bottom-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  @media (min-width: 768px) {
    .footer-bottom-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-copyright-text {
    font-family: var(--font-label-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-secondary-fixed);
    opacity: 0.6;
    text-align: center;
  }

  .footer-payment-icons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .payment-icon-svg {
    height: 1.5rem;
    width: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer Section",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Restoring the dignity of the trade through artisanal craft and ethical sourcing from local family farms."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer Navigation Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Join the Registry"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Receive exclusive access to dry-aged reserves and limited heritage breeds."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ]
}
{% endschema %}
