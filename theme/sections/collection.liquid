<script>
  // Collection Sorting listener
  const sortSelect = document.getElementById('sort-by-select');
  if (sortSelect) {
    sortSelect.addEventListener('change', (e) => {
      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', e.target.value);
      window.location.href = url.href;
    });
  }
</script>

{% stylesheet %}
  .collection-page-section {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--spacing-section-gap-mobile) var(--page-margin);
  }

  @media (min-width: 768px) {
    .collection-page-section {
      padding: var(--spacing-section-gap) var(--page-margin);
    }
  }

  .collection-header-panel {
    display: flex;
    flex-direction: column;
    margin-bottom: 3.5rem;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .collection-header-panel {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .collection-meta-text {
    max-width: 38rem;
  }

  .collection-page-title {
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .collection-page-description {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant);
    font-style: italic;
  }

  .collection-controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .collection-controls {
      align-items: flex-end;
      width: auto;
    }
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.5rem 1.25rem;
    border-radius: var(--style-border-radius);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .filter-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-chip.active {
    background-color: var(--color-primary-container);
    color: var(--color-secondary);
    border-color: var(--color-primary-container);
  }

  .sort-selector-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .sort-label {
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-outline);
  }

  .sort-dropdown-custom {
    background-color: var(--color-surface-container-high) !important;
    border: 1px solid rgba(228, 228, 204, 0.1) !important;
    color: var(--color-foreground) !important;
    font-family: var(--font-label-family) !important;
    font-size: 0.75rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.1em !important;
    text-transform: uppercase !important;
    padding: 0.5rem 2.5rem 0.5rem 1rem !important;
    cursor: pointer !important;
    border-radius: var(--style-border-radius) !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23e5e2e1'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E") !important;
    background-repeat: no-repeat !important;
    background-position: right 0.75rem center !important;
    background-size: 1.25rem !important;
  }

  .products-list-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 640px) {
    .products-list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .products-list-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .products-list-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .collection-product-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--style-border-radius);
    overflow: hidden;
    transition: border-color 0.4s ease;
  }

  .collection-product-card.border-outline {
    border: 1px solid rgba(228, 228, 204, 0.05);
  }

  .collection-product-card:hover {
    border-color: rgba(228, 228, 204, 0.25);
  }

  .image-container-dark {
    position: relative;
    background-color: var(--color-surface-container-lowest);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .product-card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-image-link img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .hover-effect img {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-product-card:hover .hover-effect img,
  .collection-product-card:hover img {
    transform: none !important;
  }

  .quick-add-btn-circle {
    border-radius: 50% !important;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4) !important;
  }

  .collection-product-card:hover .quick-add-btn-circle {
    opacity: 1 !important;
    transform: translate(0, 0) !important;
  }

  .paper-bg {
    background-color: #f5f5dc; /* Cream parchment fallback */
    background-image: url('https://lh3.googleusercontent.com/aida/AP1WRLsFkTdzROoOz7jUpqEn2a0w899NJIPEpPlNYFXAgS3TLRtOgOZozIbJQnq7GLCJvfw-W4Bj4B7ATLa8Pn1lPNvRBzrXL_LHfYdmRUSLVrfY0gLuIu-S5_lSVy32bnRVjFQN4-wsfx37k9iLOw2Lp-i80CNC9-Y22lTZKTXUz3c2oP7eiZVIt-zAjcEWZ4qsLqh5sj2OaWMBREjjBY0xUidPJEGH0o1-3G4HAg_2PSr5_xZ2puFq7JJyphxm');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    padding: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    flex-grow: 1 !important;
  }

  .text-surface-container-lowest {
    color: #1c1b1b !important; /* Dark charcoal text color for details */
  }

  .text-surface-container-lowest h3 a {
    color: #0e0e0e !important;
    text-decoration: none;
    font-family: var(--font-headline-family);
    font-weight: 700;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .text-surface-container-lowest h3 a:hover {
    color: #800020 !important; /* burgundy hover */
  }

  .text-burgundy {
    color: #800020 !important;
    font-family: var(--font-headline-family);
    font-weight: 700;
    font-size: 1.5rem;
  }

  .text-burgundy\/60 {
    color: rgba(128, 0, 32, 0.6) !important;
  }

  .discover-btn-panel {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }

  .discover-more-btn {
    padding: 1rem 3rem !important;
    letter-spacing: 0.2em !important;
    border-width: 2px !important;
  }

  .pagination-container {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    margin-top: 4rem;
    gap: 0.5rem;
  }

  .pagination-container a,
  .pagination-container .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: var(--style-border-radius);
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--color-outline-variant);
    color: var(--color-on-surface-variant);
    transition: all 0.3s ease;
  }

  .pagination-container span:not(.current) {
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
  }

  .pagination-container a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .pagination-container .current {
    background-color: var(--color-primary-container);
    color: var(--color-secondary);
    border-color: var(--color-primary-container);
  }

  .paper-bg .mt-auto {
    margin-top: auto !important; /* Push price block to bottom of details flexbox */
    margin-bottom: 0.75rem !important; /* Snug spacing above the button */
  }

  .plp-add-to-cart-form {
    width: 100%;
    margin-top: 0 !important;
    padding-top: 0;
  }

  .plp-add-to-cart-submit {
    width: 100%;
    background-color: var(--color-primary-container) !important;
    color: var(--color-secondary) !important;
    font-family: var(--font-label-family);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.75rem 1rem;
    border: none !important;
    border-radius: var(--style-border-radius);
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: none !important;
    outline: none !important;
    margin-top: 0 !important; /* Sit immediately below price block */
  }

  .plp-add-to-cart-submit:hover:not(:disabled) {
    background-color: #5d0016 !important;
    transform: translateY(-1px);
  }

  .plp-add-to-cart-submit:active:not(:disabled) {
    transform: translateY(0);
  }

  .plp-add-to-cart-submit:disabled,
  .plp-add-to-cart-submit.disabled {
    background-color: rgba(0, 0, 0, 0.05) !important;
    color: rgba(27, 29, 14, 0.4) !important;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product List Page",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per Page"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable Category Filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable Sorting Options",
      "default": true
    },
    {
      "type": "link_list",
      "id": "filter_menu",
      "label": "Filter Menu",
      "info": "Select a menu (e.g. Navigation menu) to control the filter chips. If selected, this menu will be used instead of section blocks."
    },
    {
      "type": "text",
      "id": "all_collection_label",
      "label": "All Products Label",
      "default": "All Cuts",
      "info": "Label for the first filter chip (e.g. 'All Cuts' or 'All Accessories')"
    },
    {
      "type": "collection",
      "id": "all_collection",
      "label": "All Products Collection",
      "info": "Optional collection for the first filter chip. If empty, links to all products in the store (/collections/all)."
    }
  ],
  "blocks": [
    {
      "type": "filter_collection",
      "name": "Filter Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Filter Label",
          "info": "Optional. Falls back to collection title."
        }
      ]
    }
  ]
}
{% endschema %}
