<div class="collection-page-section">
  <!-- Header & Controls -->
  <div class="collection-header-panel">
    <div class="collection-meta-text">
      <h1 class="collection-page-title">{{ collection.title }}</h1>
      <p class="collection-page-description">
        {% if collection.description != blank %}
          {{ collection.description | strip_html }}
        {% else %}
          From pasture to paper. Our master butchers select only the finest heritage breeds, hand-cut with artisanal precision.
        {% endif %}
      </p>
    </div>

    <div class="collection-controls">
      <!-- Filter Chips -->
      {% if section.settings.enable_filtering %}
        <div class="filter-chips">
          {% assign filter_menu_handle = section.settings.filter_menu %}
          {% if filter_menu_handle != blank and linklists[filter_menu_handle].links.size > 0 %}
            {% for link in linklists[filter_menu_handle].links %}
              {% assign link_active = false %}
              {% if collection.url == link.url or collection.handle == link.object.handle %}
                {% assign link_active = true %}
              {% endif %}
              <a href="{{ link.url }}" class="filter-chip {% if link_active %}active{% endif %}">
                {{ link.title }}
              </a>
            {% endfor %}
          {% else %}
            <!-- Block-based or Fallback Filters -->
            {% assign all_url = section.settings.all_collection.url | default: '/collections/all' %}
            {% assign all_handle = section.settings.all_collection.handle | default: 'all' %}
            {% assign all_label = section.settings.all_collection_label | default: 'All Cuts' %}
            <a href="{{ all_url }}" class="filter-chip {% if collection.handle == all_handle or collection.handle == 'frontpage' or collection.handle == blank %}active{% endif %}">
              {{ all_label }}
            </a>
            {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'filter_collection' %}
                  {% assign filter_collection = block.settings.collection %}
                  {% if filter_collection != blank %}
                    {% assign label = block.settings.label | default: filter_collection.title %}
                    <a href="{{ filter_collection.url }}" class="filter-chip {% if collection.handle == filter_collection.handle %}active{% endif %}" {{ block.shopify_attributes }}>
                      {{ label }}
                    </a>
                  {% endif %}
                {% endif %}
              {% endfor %}
            {% else %}
              <!-- Default Fallback Filters -->
              <a href="/collections/beef" class="filter-chip {% if collection.handle == 'beef' %}active{% endif %}">Beef</a>
              <a href="/collections/pork" class="filter-chip {% if collection.handle == 'pork' %}active{% endif %}">Pork</a>
              <a href="/collections/lamb" class="filter-chip {% if collection.handle == 'lamb' %}active{% endif %}">Lamb</a>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}

      <!-- Sort Selection -->
      {% if section.settings.enable_sorting %}
        <div class="sort-selector-wrapper">
          <span class="sort-label">Sort by:</span>
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          <select id="sort-by-select" class="sort-dropdown-custom">
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>
                {{ option.name }}
              </option>
            {% endfor %}
          </select>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Product Grid -->
  <div class="products-list-grid">
    {% if collection.products_count > 0 %}
      {% paginate collection.products by section.settings.products_per_page %}
        {% for product in collection.products %}
          <div class="collection-product-card group flex flex-col bg-surface-container-low border-outline hover-effect">
            <div class="relative aspect-square overflow-hidden image-container-dark">
              {% if product.compare_at_price > product.price %}
                <div class="absolute top-4 left-4 z-10 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 uppercase">Sale</div>
              {% elsif product.available == false %}
                <div class="absolute top-4 left-4 z-10 bg-surface-container-highest text-on-surface-variant font-label-caps text-label-caps px-3 py-1 uppercase">Sold Out</div>
              {% else %}
                {% for tag in product.tags %}
                  {% if tag contains 'Aged' or tag contains 'Organic' or tag contains 'organic' or tag contains 'Limited' or tag contains 'limited' or tag contains 'Signature' or tag contains 'Heirloom' %}
                    <div class="absolute top-4 left-4 z-10 bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps px-3 py-1 uppercase">{{ tag }}</div>
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              <a href="{{ product.url }}" class="product-card-image-link">
                {% if product.featured_image %}
                  <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="300" height="300" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 placeholder-svg' }}
                {% endif %}
              </a>
            </div>
            
            <div class="paper-bg p-6 flex flex-col flex-grow text-surface-container-lowest">
              <span class="font-label-caps text-[10px] uppercase tracking-widest text-burgundy/60 mb-1">{{ product.type | default: "Heritage Cut" }}</span>
              <h3 class="font-headline-sm text-headline-sm mb-2 text-surface-container-lowest"><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="font-body-md text-body-md italic mb-4 opacity-80">{{ product.description | strip_html | truncatewords: 8 }}</p>
              <div class="mt-auto flex justify-between items-center mb-4">
                <span class="font-headline-md text-headline-md text-burgundy">{{ product.price | money }}</span>
              </div>

              {% if product.available %}
                <form method="post" action="{{ routes.cart_add_url }}" class="plp-add-to-cart-form">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                  <button type="submit" class="plp-add-to-cart-submit">Add to Box</button>
                </form>
              {% else %}
                <button class="plp-add-to-cart-submit disabled" disabled>Sold Out</button>
              {% endif %}
            </div>
          </div>
        {% endfor %}

        <!-- Pagination -->
        {% if paginate.pages > 1 %}
          <div class="pagination-container">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% endpaginate %}
