<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,200..900;1,8..60,200..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap" rel="stylesheet">

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
    <script>
      // Global AJAX Add to Cart interceptor
      document.addEventListener('submit', function(e) {
        const form = e.target;
        const action = form.getAttribute('action') || '';
        
        if (action.includes('/cart/add')) {
          e.preventDefault();
          
          const submitBtn = form.querySelector('[type="submit"]') || form.querySelector('button') || form.querySelector('input[type="submit"]');
          if (!submitBtn) return;
          
          const formData = new FormData(form);
          const originalText = submitBtn.textContent || submitBtn.value;
          
          submitBtn.disabled = true;
          if (submitBtn.tagName === 'INPUT') {
            submitBtn.value = 'Adding...';
          } else {
            submitBtn.textContent = 'Adding...';
          }
          
          const rootUrl = window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/';
          
          fetch(rootUrl + 'cart/add.js', {
            method: 'POST',
            body: formData
          })
          .then(response => {
            if (!response.ok) {
              throw new Error('Error adding to cart');
            }
            return response.json();
          })
          .then(data => {
            if (submitBtn.tagName === 'INPUT') {
              submitBtn.value = 'Added!';
            } else {
              submitBtn.textContent = 'Added!';
            }
            submitBtn.classList.add('success');
            
            return fetch(rootUrl + 'cart.js');
          })
          .then(response => response.json())
          .then(cart => {
            const badges = document.querySelectorAll('.nav-badge-count');
            badges.forEach(badge => {
              badge.textContent = cart.item_count;
              badge.style.display = cart.item_count > 0 ? 'inline-flex' : 'none';
              
              // Visual bounce effect
              badge.style.transform = 'scale(1.3)';
              badge.style.transition = 'transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
              setTimeout(() => {
                badge.style.transform = 'scale(1)';
              }, 200);
            });
            
            setTimeout(() => {
              submitBtn.disabled = false;
              if (submitBtn.tagName === 'INPUT') {
                submitBtn.value = originalText;
              } else {
                submitBtn.textContent = originalText;
              }
              submitBtn.classList.remove('success');
            }, 2000);
          })
          .catch(error => {
            console.error('AJAX add to cart error:', error);
            if (submitBtn.tagName === 'INPUT') {
              submitBtn.value = 'Error';
            } else {
              submitBtn.textContent = 'Error';
            }
            submitBtn.disabled = false;
            setTimeout(() => {
              if (submitBtn.tagName === 'INPUT') {
                submitBtn.value = originalText;
              } else {
                submitBtn.textContent = originalText;
              }
            }, 2000);
          });
        }
      });
    </script>
  </body>
</html>
