      </div>

      <!-- Product 2 -->
      <div class="collection-product-card group flex flex-col bg-surface-container-low border-outline hover-effect">
        <div class="relative aspect-square overflow-hidden image-container-dark">
          <div class="absolute top-4 left-4 z-10 bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps px-3 py-1 uppercase">Limited</div>
          <a href="#" class="product-card-image-link">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCy9X0tjeB0ptnSC-OKzZmaTp8MUcTH5YVb9FhzUnXoOtJS8RtZO-NJo-RinKRvJoK1QBIM1yrJNR_6znPV68gH8BkxJjgNHNjFwex1Rs--R22yuPhne2DO8hbqLkS7d6mXkCBBSKDCr1XlF1yh3UeN_6ojVqLHMm_bxAPNVqqUI323BWPwe7e0pZjLaW0yPzJJbS0i35Pn9-pGvqzb1-aOySkToanQ3TgNXt_DtK74E_ZeFo1kyotnetuqPdMN3zcgjRo_H8i29qPA" alt="Center-Cut Fillet" width="300" height="300" loading="lazy">
          </a>
        </div>
        <div class="paper-bg p-6 flex flex-col flex-grow text-surface-container-lowest">
          <span class="font-label-caps text-[10px] uppercase tracking-widest text-burgundy/60 mb-1">Grass-Fed Prime</span>
          <h3 class="font-headline-sm text-headline-sm mb-2 text-surface-container-lowest"><a href="#">Center-Cut Fillet</a></h3>
          <p class="font-body-md text-body-md italic mb-4 opacity-80">Pasture-raised tenderness cut by hand.</p>
          <div class="mt-auto flex justify-between items-center mb-4">
            <span class="font-headline-md text-headline-md text-burgundy">$58.00</span>
          </div>
          <button class="plp-add-to-cart-submit">Add to Box</button>
        </div>
      </div>

      <!-- Product 3 -->
      <div class="collection-product-card group flex flex-col bg-surface-container-low border-outline hover-effect">
        <div class="relative aspect-square overflow-hidden image-container-dark">
          <div class="absolute top-4 left-4 z-10 bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps px-3 py-1 uppercase">Signature</div>
          <a href="#" class="product-card-image-link">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTSsz37cP0fP-TD-NuHsSLEN0Uuh-MNa68bjuIrBbGaWlWf_DMDMXVp5HezzGMZj-L4HPpLGNfXeKXme7EarZzK9zJr2Eqhl2PwkftF2AqG0viQpSJEMAQrQfQlBxIhkm62e_HTiRZKElrVKjbUOnFPYf8ELs8rrtCVRrJ8sTsB7mTC2Dky4KserzWNH48iHP-qjKIag2DPU1nZrEpsek-WqD8dXT5mQBLf5RPar7hSHUPO3Albtpl7NyfQrULW4D87fOwIkDyPREA" alt="Double Rib Lamb Chops" width="300" height="300" loading="lazy">
          </a>
        </div>
        <div class="paper-bg p-6 flex flex-col flex-grow text-surface-container-lowest">
          <span class="font-label-caps text-[10px] uppercase tracking-widest text-burgundy/60 mb-1">Highland Spring Lamb</span>
          <h3 class="font-headline-sm text-headline-sm mb-2 text-surface-container-lowest"><a href="#">Double Rib Lamb Chops</a></h3>
          <p class="font-body-md text-body-md italic mb-4 opacity-80">French-trimmed by our master butchers.</p>
          <div class="mt-auto flex justify-between items-center mb-4">
            <span class="font-headline-md text-headline-md text-burgundy">$42.00</span>
          </div>
          <button class="plp-add-to-cart-submit">Add to Box</button>
        </div>
      </div>
      
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .featured-products-section {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .featured-products-heading {
    text-align: center;
    margin-bottom: 4rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .collection-product-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--style-border-radius);
    overflow: hidden;
    transition: border-color 0.4s ease;
  }

  .collection-product-card.border-outline {
    border: 1px solid rgba(228, 228, 204, 0.05);
  }

  .collection-product-card:hover {
    border-color: rgba(228, 228, 204, 0.25);
  }

  .image-container-dark {
    position: relative;
    background-color: var(--color-surface-container-lowest);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .product-card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-image-link img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .hover-effect img {
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-product-card:hover .hover-effect img,
  .collection-product-card:hover img {
    transform: none !important;
  }

  .paper-bg .mt-auto {
    margin-top: auto !important; /* Push price block to bottom of details flexbox */
    margin-bottom: 0.75rem !important; /* Snug spacing above the button */
  }

  .plp-add-to-cart-form {
    width: 100%;
    margin-top: 0 !important;
    padding-top: 0;
  }

  .plp-add-to-cart-submit {
    width: 100%;
    background-color: var(--color-primary-container) !important;
    color: var(--color-secondary) !important;
    font-family: var(--font-label-family);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.75rem 1rem;
    border: none !important;
    border-radius: var(--style-border-radius);
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: none !important;
    outline: none !important;
    margin-top: 0 !important; /* Sit immediately below price block */
  }

  .plp-add-to-cart-submit:hover:not(:disabled) {
    background-color: var(--color-secondary-container) !important;
    color: var(--color-on-secondary-container) !important;
  }

  .plp-add-to-cart-submit:disabled,
  .plp-add-to-cart-submit.disabled {
    background-color: var(--color-surface-container-highest) !important;
    color: var(--color-on-surface-variant) !important;
    cursor: not-allowed !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Butcher's Recommendation"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
