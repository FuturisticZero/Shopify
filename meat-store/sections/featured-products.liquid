</div>

{% stylesheet %}
  .featured-products-section {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .featured-products-heading {
    text-align: center;
    margin-bottom: 4rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .product-card-custom {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface-container);
    border-radius: var(--style-border-radius);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), border-color 0.4s ease;
  }

  .product-card-custom.border-outline {
    border: 1px solid rgba(228, 228, 204, 0.1);
  }

  .product-card-custom:hover {
    transform: none !important;
    border-color: rgba(228, 228, 204, 0.3);
  }

  .product-card-image-wrapper {
    position: relative;
    height: 280px;
    overflow: hidden;
    background-color: var(--color-surface-container-lowest);
  }

  .product-card-image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .product-card-custom:hover .product-card-image {
    transform: none !important;
  }

  .product-card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.5rem;
    background-color: var(--color-secondary);
    color: var(--color-background);
    border-radius: 2px;
  }

  .product-card-badge.bg-burgundy {
    background-color: var(--color-primary-container);
    color: var(--color-foreground);
  }

  .product-card-badge--soldout {
    background-color: var(--color-surface-container-highest);
    color: var(--color-on-surface-variant);
  }

  .product-card-badge--sale {
    background-color: #ba1a1a;
    color: #ffffff;
  }

  .product-card-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .product-card-title {
    margin-bottom: 0.25rem;
  }

  .product-card-title a {
    text-decoration: none;
    color: var(--color-on-surface);
    font-family: var(--font-headline-family);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .product-card-title a:hover {
    color: var(--color-primary);
  }

  .product-card-vendor {
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
  }

  .product-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .product-card-price {
    font-family: var(--font-headline-family);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .quick-add-form {
    margin: 0;
  }

  .quick-add-btn {
    border-radius: 50% !important;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0 !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Butcher's Recommendation"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
