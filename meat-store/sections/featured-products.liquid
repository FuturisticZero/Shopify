<div class="featured-products-section">
  <h2 class="featured-products-heading">{{ section.settings.heading }}</h2>
  
  <div class="products-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <div class="collection-product-card group flex flex-col bg-surface-container-low border-outline hover-effect">
          <div class="relative aspect-square overflow-hidden image-container-dark">
            {% if product.compare_at_price > product.price %}
              <div class="absolute top-4 left-4 z-10 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 uppercase">Sale</div>
            {% elsif product.available == false %}
              <div class="absolute top-4 left-4 z-10 bg-surface-container-highest text-on-surface-variant font-label-caps text-label-caps px-3 py-1 uppercase">Sold Out</div>
            {% else %}
              {% for tag in product.tags %}
                {% if tag contains 'Aged' or tag contains 'Organic' or tag contains 'organic' or tag contains 'Limited' or tag contains 'limited' or tag contains 'Signature' or tag contains 'Heirloom' %}
                  <div class="absolute top-4 left-4 z-10 bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps px-3 py-1 uppercase">{{ tag }}</div>
                  {% break %}
                {% endif %}
              {% endfor %}
            {% endif %}

            <a href="{{ product.url }}" class="product-card-image-link">
              {% if product.featured_image %}
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="300" height="300" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 placeholder-svg' }}
              {% endif %}
            </a>
          </div>
          
          <div class="paper-bg p-6 flex flex-col flex-grow text-surface-container-lowest">
            <span class="font-label-caps text-[10px] uppercase tracking-widest text-burgundy/60 mb-1">{{ product.type | default: "Heritage Cut" }}</span>
            <h3 class="font-headline-sm text-headline-sm mb-2 text-surface-container-lowest"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="font-body-md text-body-md italic mb-4 opacity-80">{{ product.description | strip_html | truncatewords: 8 }}</p>
            
            <div class="mt-auto flex justify-between items-center mb-4">
              <span class="font-headline-md text-headline-md text-burgundy">{{ product.price | money }}</span>
            </div>

            {% if product.available %}
              <form method="post" action="{{ routes.cart_add_url }}" class="plp-add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
                <button type="submit" class="plp-add-to-cart-submit">Add to Box</button>
              </form>
            {% else %}
              <button class="plp-add-to-cart-submit disabled" disabled>Sold Out</button>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      <!-- Fallback Mock Products matching Stitch Design System -->
      
      <!-- Product 1 -->
      <div class="collection-product-card group flex flex-col bg-surface-container-low border-outline hover-effect">
        <div class="relative aspect-square overflow-hidden image-container-dark">
          <div class="absolute top-4 left-4 z-10 bg-primary text-on-primary font-label-caps text-label-caps px-3 py-1 uppercase">Aged 45 Days</div>
          <a href="#" class="product-card-image-link">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAMa7ZvsxDMMg5toGQ7OkJFi-ujwh0a8upUWd-4Yp8zM4qgsBSn7hvFrEnKDERdZFbc5caRKYnL-VhqvPsb82-CGLTS0Xh9w-57h4iq-lGDoVuQKSQ7OgoBCtvPAKc3hhUjVMyL3eNdRCk57NQnCoBIXca3O-PLxA3YGvC3rFLKywneqNjWTLBliVceore8UYX02gf5eOwDeaA-g4UJlVUkHjKHnP_4R3Hxe7tqcDe-5noc3o5ZkWvZVxUzdJsU16bKidm94kDeeTVg" alt="Bone-In Ribeye" width="300" height="300" loading="lazy">
          </a>
        </div>
        <div class="paper-bg p-6 flex flex-col flex-grow text-surface-container-lowest">
          <span class="font-label-caps text-[10px] uppercase tracking-widest text-burgundy/60 mb-1">Grass-Fed Beef</span>
          <h3 class="font-headline-sm text-headline-sm mb-2 text-surface-container-lowest"><a href="#">Bone-In Ribeye</a></h3>
          <p class="font-body-md text-body-md italic mb-4 opacity-80">Distinctive marbling with a buttery finish.</p>
          <div class="mt-auto flex justify-between items-center mb-4">
            <span class="font-headline-md text-headline-md text-burgundy">$74.00</span>
          </div>
          <button class="plp-add-to-cart-submit">Add to Box</button>
