    transform: rotate(12deg) translate(0.5rem, -0.5rem);
    border-radius: var(--style-border-radius);
  }

  .summary-badge-icon .material-symbols-outlined {
    font-size: 1.5rem !important;
    color: #800020;
  }

  /* Line Items */
  .checkout-line-items-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-bottom: 2px solid rgba(27, 29, 14, 0.1);
    padding-bottom: 1.5rem;
