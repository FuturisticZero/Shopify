    height: 4rem;
    background-color: rgba(128, 0, 32, 0.06);
    border-left: 1px solid rgba(128, 0, 32, 0.1);
    border-bottom: 1px solid rgba(128, 0, 32, 0.1);
    display: flex;
    align-items: center;
