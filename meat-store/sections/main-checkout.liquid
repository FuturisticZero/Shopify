    gap: 1rem;
  }

  .checkout-trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .checkout-trust-icon {
    font-size: 1.25rem !important;
    color: var(--color-secondary);
  }

  .checkout-trust-text {
    font-family: var(--font-label-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
