  }

  .shipping-option-price {
    font-family: var(--font-headline-family);
    font-size: 1rem;
    font-weight: 700;
    color: #1b1d0e;
  }

  /* Bottom Trust Row */
  .checkout-trust-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1rem;
    opacity: 0.6;
