    font-size: 0.75rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    border: none !important;
    cursor: pointer !important;
    transition: background-color 0.3s ease !important;
  }

  .mobile-newsletter-submit:hover {
    background-color: #5d0016 !important;
  }

  .mobile-drawer-socials {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 1px solid rgba(27, 29, 14, 0.08);
    padding-top: 1.5rem;
  }

  .mobile-social-icons {
    display: flex;
    gap: 1rem;
  }

  .mobile-social-icon-btn {
    color: #1b1d0e !important;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .mobile-social-icon-btn:hover {
    color: #800020 !important;
  }

  .mobile-social-icon-btn .material-symbols-outlined {
    font-size: 1.5rem;
  }

  .mobile-copyright-text {
    font-family: var(--font-label-family);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(27, 29, 14, 0.4);
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header Navigation",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer Account Menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
