        {% endif %}
      </div>

      <!-- Thumbnails Grid -->
      <div class="pdp-thumbnails-grid">
        {% if product.images.size > 0 %}
          {% for image in product.images %}
            <div class="pdp-thumbnail-wrapper {% if forloop.first %}active-thumb{% endif %}">
              <img class="pdp-thumbnail-img" src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | escape }}" width="80" height="80" loading="lazy" data-hero-src="{{ image | image_url: width: 1200 }}">
