<script>
  // Image gallery switcher
  const thumbs = document.querySelectorAll('.pdp-thumbnail-wrapper');
  const mainHeroImage = document.getElementById('pdp-hero-image');

  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      // Remove active states
      thumbs.forEach(t => t.classList.remove('active-thumb'));
      // Add active state to clicked
      thumb.classList.add('active-thumb');

      // Swap image sources
      const imgEl = thumb.querySelector('.pdp-thumbnail-img');
      if (imgEl && mainHeroImage) {
        mainHeroImage.src = imgEl.dataset.heroSrc;
        mainHeroImage.alt = imgEl.alt;
      }
    });

    // Also support hover activation
    thumb.addEventListener('mouseover', () => {
      const imgEl = thumb.querySelector('.pdp-thumbnail-img');
      if (imgEl && mainHeroImage) {
        mainHeroImage.src = imgEl.dataset.heroSrc;
      }
    });
  });

  // Variant selector buttons interactive script
  const optionButtons = document.querySelectorAll('.pdp-option-btn');
  const variantInput = document.getElementById('pdp-selected-variant-id');
  const priceDisplay = document.getElementById('pdp-price-display');
  const weightLabel = document.getElementById('pdp-price-weight-label');

  optionButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Deactivate all buttons
      optionButtons.forEach(b => b.classList.remove('active-option'));
      
      // Activate clicked
      btn.classList.add('active-option');

      // Update input variant ID value
      const variantId = btn.dataset.variantId;
      if (variantInput && variantId) {
        variantInput.value = variantId;
      }

      // Update price display
      const price = btn.dataset.variantPrice;
      if (priceDisplay && price) {
        priceDisplay.innerText = price;
      }

      // Update weight label
      const weight = btn.dataset.variantWeight;
      if (weightLabel && weight) {
        weightLabel.innerText = weight;
      }
    });
  });
</script>

{% stylesheet %}
  .product-page-section {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--spacing-section-gap-mobile) var(--page-margin);
  }

  @media (min-width: 768px) {
    .product-page-section {
      padding: var(--spacing-section-gap) var(--page-margin);
    }
  }

  .pdp-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-family: var(--font-label-family);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
  }

  .pdp-breadcrumbs a {
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pdp-breadcrumbs a:hover {
    color: var(--color-primary);
  }

  .breadcrumb-arrow {
    font-size: 0.875rem !important;
  }

  .breadcrumb-current {
    color: var(--color-primary);
  }

  .pdp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-gutter);
  }

  @media (min-width: 1024px) {
    .pdp-grid {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  .pdp-gallery-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .pdp-gallery-container {
      grid-column: span 7;
    }
  }

  .pdp-main-image-wrapper {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-surface-container-lowest);
    border-radius: var(--style-border-radius);
    border: 1px solid rgba(228, 228, 204, 0.05);
  }

  .pdp-main-image {
    width: 100%;
    height: 100%;
    object-cover: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pdp-main-image-wrapper:hover .pdp-main-image {
    transform: none !important;
  }

  .pdp-gallery-badges {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pdp-badge {
    font-family: var(--font-label-family);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.375rem 0.75rem;
    border-radius: var(--style-border-radius);
  }

  .pdp-badge--sale {
    background-color: var(--color-primary-container);
    color: var(--color-secondary);
  }

  .pdp-badge--tag {
    background-color: var(--color-primary-container);
    color: #ffffff;
  }

  .pdp-badge--secondary {
    background-color: var(--color-surface-container-highest);
    color: var(--color-secondary);
  }

  .pdp-thumbnails-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

