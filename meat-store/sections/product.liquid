  <nav class="pdp-breadcrumbs">
    <a href="/collections/all">Shop</a>
    <span class="material-symbols-outlined breadcrumb-arrow">chevron_right</span>
    {% if product.collections.size > 0 %}
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      <span class="material-symbols-outlined breadcrumb-arrow">chevron_right</span>
    {% endif %}
    <span class="breadcrumb-current">{{ product.title | default: "Signature Dry-Aged Ribeye" }}</span>
