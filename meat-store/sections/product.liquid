    },
    {
      "type": "text",
      "id": "farm_name",
      "label": "Farm Name Sourcing",
      "default": "Heritage Oaks Farm, VT"
    },
    {
      "type": "collection",
      "id": "pairings_collection",
      "label": "Pairings Collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
