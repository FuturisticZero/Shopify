          {% if product.compare_at_price > product.price %}
            <span class="pdp-badge pdp-badge--sale">Sale</span>
          {% endif %}
          {% for tag in product.tags %}
            {% if tag contains 'Aged' or tag contains 'organic' or tag contains 'Organic' or tag contains 'Limited' or tag contains 'Signature' %}
              <span class="pdp-badge pdp-badge--tag">{{ tag }}</span>
            {% endif %}
          {% endfor %}
          {% if product.tags.size == 0 and product == blank %}
            <span class="pdp-badge pdp-badge--tag">45-Day Aged</span>
            <span class="pdp-badge pdp-badge--secondary">Limited Release</span>
          {% endif %}
        </div>

        {% if product.featured_image %}
          <img id="pdp-hero-image" class="pdp-main-image" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | escape }}" width="600" height="750" loading="eager">
