            {% endif %}
          </div>

          <!-- Add to Cart Form -->
          {% form 'product', product, class: 'pdp-cart-form' %}
            <!-- Hidden option selector input -->
            <input type="hidden" id="pdp-selected-variant-id" name="id" value="{{ current_variant.id | default: 12345678 }}" />

            {% unless product.has_only_default_variant %}
              <!-- Variant Option Selection Buttons -->
              <div class="pdp-options-container">
                <label class="pdp-option-title">Select Cut Weight</label>
                
                <div class="pdp-option-buttons-grid">
                  {% if product.variants.size > 0 %}
                    {% for variant in product.variants %}
                      <button type="button" class="pdp-option-btn {% if variant == current_variant %}active-option{% endif %}" 
                              data-variant-id="{{ variant.id }}" 
                              data-variant-price="{{ variant.price | money }}"
                              data-variant-available="{{ variant.available }}">
                        {{ variant.title }}
                      </button>
                    {% endfor %}
                  {% else %}
                    <!-- Fallback Mock Variants -->
                    <button type="button" class="pdp-option-btn" data-variant-price="$52.00" data-variant-weight="Price per cut">14 OZ</button>
                    <button type="button" class="pdp-option-btn active-option" data-variant-price="$64.00" data-variant-weight="Price per cut">18 OZ</button>
                    <button type="button" class="pdp-option-btn" data-variant-price="$78.00" data-variant-weight="Price per cut">22 OZ</button>
